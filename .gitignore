# ── Secrets — never commit these ──────────────────────────────────────────────
.env
backend/.env
frontend/.env

# ── Dependencies ───────────────────────────────────────────────────────────────
frontend/node_modules/
vendor/

# ── Build output ───────────────────────────────────────────────────────────────
frontend/dist/
deploy_package/
# public_html/ is intentionally tracked — contains the built frontend for deployment

# ── Uploads (user-generated content) ──────────────────────────────────────────
backend/public/uploads/
backend/uploads/

# ── Claude Code (contains API keys / tokens) ───────────────────────────────────
.claude/settings.local.json
.claude1/

# ── Database dumps ────────────────────────────────────────────────────────────
*.sql

# ── OS / editor ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.log
